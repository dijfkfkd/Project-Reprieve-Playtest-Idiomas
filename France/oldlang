[modifiersdescriptions]
whim = "Whim aparece. Avanza hacia tu oficina desde la cámara 1; hazle un parry cuando aparezca."
whim1 = "El tiempo que tienes para hacerle parry a Whim se reduce."
whim2 = "Después de hacerle parry a Whim, debes ir a la cámara 1 y darle una descarga."
n = "N aparece. Entra a la oficina desde la cámara 1; lánzale la piedra."
n1 = "Ahora N requiere que se le lance una piedra adicional para quitárselo de encima."
twoany = "2any aparece. Avanza desde la cámara 2; cierra la puerta cuando la escuches hablar."
twoany1 = "2any no se irá de inmediato; en su lugar, requiere que la puerta permanezca cerrada durante medio segundo."
twoany2 = "Ahora hay dos 2any."
wanton = "Wanton aparece. Avanza hacia tu oficina; mueve el ratón verticalmente mientras lo mantienes sobre ella para hacer que se vaya."
wanton1 = "Wanton requiere más movimientos de ratón para irse y su temporizador de muerte es más largo."
wanton2 = "Ahora Wanton puede aparecer en cualquiera de los lados de la oficina."
pompous = "Pompous aparece. Avanza desde la cámara 1 hacia tu oficina; quédate quieto con el ratón sobre él hasta que se vaya."
pompous1 = "Pompous ahora puede atacar desde cualquier lado y se desvanecerá después de aparecer."
creep = "creep aparece. Se desplaza por la cámara 7; dale una descarga para hacerlo retroceder una fase."
creep1 = "creep se mueve más rápido cuanto más tiempo pases sin revisarlo."
rancor = "RANCOR aparece. Se mueve desde la cámara 6 o 7 antes de aparecer en la oficina por un lado; hazle un parry."
rancor1 = "RANCOR ataca 4 veces seguidas, cambiando de lado cada vez."
rancor2 = "Hay 2 RANCOR y atacan al mismo tiempo."
stitchwork = "Stitchwork aparece. Aparecerá junto a una alucinación de sí mismo; dale una descarga en la cámara marcada de marrón."
stitchwork1 = "La alucinación de Stitchwork se desvanecerá cuando empiece su ataque."
stitchwork2 = "Stitchwork requiere 2 descargas y se mueve después de recibir una."
conceit = "Conceit aparece. Cuando aparezca, quédate quieto rápidamente en la oficina en cuanto abra la boca."
conceit1 = "A Conceit no se le puede hacer parry; hacerlo simplemente reinicia su ataque."
conceit2 = "Debes estar quieto ANTES de que Conceit abra la boca."
qualm = "Qualm aparece. Ocasionalmente aparecerá en la oficina; hazle parry 3 veces para que se vaya, moviéndose cada vez."
qualm1 = "Qualm ahora se mueve constantemente."
qualm2 = "Qualm drenará pasivamente la VELOCIDAD mientras ataca, haciéndolo más cuanto más avanzado esté su ataque."
reap = "Reap aparece. Seguirá el cursor de tu ratón, matándote si lo dejas quieto en un mismo lugar durante mucho tiempo."
reap1 = "Reap ahora salta hacia tu cursor en ráfagas en vez de moverse de forma fluida."
reap2 = "Hacerle parry a Reap ahora fuerza un ataque de Whim, N, RANCOR o Caustic."
caustic = "Caustic aparece. Aparecerá una señal de advertencia en la oficina; lánzale una piedra cuando aparezca."
caustic1 = "Caustic ahora se mueve después de cada destello de advertencia."
caustic2 = "Caustic solo mostrará su advertencia dos veces."
travis = "Travis aparece. Ocasionalmente se asomará por la puerta, ciérrala y luego ve a la cámara 6 o 7 para darle una descarga."
travis1 = "Travis ahora ataca con más frecuencia."
travis2 = "Travis forzará un ataque de N después de dar su golpe seco."
blackened = "Blackened aparece. Avanza por el pasillo de tu oficina. Hacer clic en él lo hará retroceder."
blackened1 = "Si Blackened llega alguna vez al 50% de progreso, solo podrás empujarlo hasta ese punto."
blackened2 = "Tus clics empujan a Blackened menos distancia."
dozer = "Dozer aparece. Mantente quieto con el cursor en el tercio inferior de la pantalla."
dozer1 = "Dozer se despierta más rápido."
dozer2 = "Dozer ahora ataca cada vez que aparece Whim."
silverroachy = "SilverRoachy aparece. Dale una descarga en las cámaras; no hacerlo durante un tiempo deshabilitará tus cámaras."
silverroachy1 = "SilverRoachy ahora avanza más rápido."
silverroachy2 = "SilverRoachy ahora es letal."
beanie = "Beanie aparece. Aparecerá aleatoriamente en la oficina, ¡golpéala!"
beanieboss = "EN SU PLENITUD"
randommodifier = "Activa un modificador aleatorio y otorga a cambio el doble de su aumento de puntuación."

