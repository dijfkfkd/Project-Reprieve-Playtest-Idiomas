[modifiersdescriptions]
whim = "Whim hace acto de presencia. Se desplaza hacia tu oficina desde la cámara 1; hazle un parry cuando aparezca."
whim1 = "El tiempo concedido para el parry de Whim se reduce."
whim2 = "Tras hacerle un parry a Whim, debes ir a la cámara 1 y darle una descarga."
n = "N hace acto de presencia. Entra en la oficina desde la cámara 1; lánzale una piedra."
n1 = "Ahora N exige que se le lance una piedra extra para espantarla."
twoany = "2any hace acto de presencia. Se desplaza desde la cámara 2; cierra la puerta cuando la oigas hablar."
twoany1 = "2any no se marcha al instante; en su lugar, exige mantener la puerta cerrada durante medio segundo."
twoany2 = "Ahora aparecen dos 2any."
wanton = "Wanton hace acto de presencia. Se desplaza hacia tu oficina; mueve el ratón en vertical manteniendo el cursor sobre ella para que se marche."
wanton1 = "Wanton exige más movimientos de ratón para irse, y su temporizador de muerte es más prolongado."
wanton2 = "Ahora Wanton puede aparecer por cualquiera de los dos lados de la oficina."
pompous = "Pompous hace acto de presencia. Se desplaza de la cámara 1 a tu oficina; quédate sin moverte con el cursor sobre ella hasta que se marche."
pompous1 = "Pompous puede atacar ahora desde cualquiera de los lados y desaparece tras aparecer."
creep = "creep hace acto de presencia. Se mueve por la cámara 7; dale una descarga para hacerla retroceder una fase."
creep1 = "creep se desplaza más deprisa cuanto más tiempo pases sin comprobarla."
rancor = "RANCOR hace acto de presencia. Se desplaza desde la cámara 6 o 7 antes de aparecer en el lateral de la oficina; hazle un parry."
rancor1 = "RANCOR ataca 4 veces seguidas, cambiando de bando en cada ocasión."
rancor2 = "Aparecen 2 RANCOR, y atacan de forma simultánea."
stitchwork = "Stitchwork hace acto de presencia. Aparecerá junto a su propia alucinación; dale una descarga en la cámara marcada en marrón."
stitchwork1 = "La alucinación de Stitchwork se desvanece al arrancar su ataque."
stitchwork2 = "Stitchwork exige 2 descargas y se mueve tras recibir una."
conceit = "Conceit hace acto de presencia. Al aparecer, inmovilízate rápidamente en la oficina en cuanto abra la boca."
conceit1 = "Conceit no admite parry; eso solo reinicia su ataque."
conceit2 = "Debes permanecer inmóvil ANTES de que Conceit abra la boca."
qualm = "Qualm hace acto de presencia. Aparece periódicamente en la oficina; hazle un parry 3 veces para hacerla marchar, cambiando de sitio cada vez."
qualm1 = "Qualm se mueve ahora de forma constante."
qualm2 = "Qualm drena pasivamente la VELOCIDAD durante el asalto, haciéndolo con más intensidad conforme avanza el ataque."
reap = "Reap hace acto de presencia. Seguirá el cursor del ratón, matándote si se le deja inmóvil demasiado tiempo."
reap1 = "Reap salta ahora hacia tu cursor a trompicones en vez de marchar con suavidad."
reap2 = "Hacerle un parry a Reap provoca un ataque de Whim, N, RANCOR o Caustic."
caustic = "Caustic hace acto de presencia. Una señal de aviso saltará en la oficina; lánzale una piedra al aparecer."
caustic1 = "Caustic se desplaza ahora tras cada destello de aviso."
caustic2 = "Caustic muestra el aviso únicamente dos veces."
travis = "Travis hace acto de presencia. De vez en cuando espiará por la puerta; ciérrala y ve a la cámara 6 o 7 para darle una descarga."
travis1 = "Travis ataca ahora con mayor frecuencia."
travis2 = "Travis provoca un ataque de N tras ejecutar su golpe rápido."
blackened = "Blackened hace acto de presencia. Se desplaza por el pasillo de tu oficina. Hacer clic en él hará que retroceda."
blackened1 = "Si Blackened alcanza el 50% de progreso, solo podrás empujarle de vuelta hasta ese punto."
blackened2 = "Tus clics empujan a Blackened una distancia menor."
dozer = "Dozer hace acto de presencia. Mantén el cursor quieto en el tercio inferior de la pantalla."
dozer1 = "Dozer se despierta más rápido."
dozer2 = "Dozer ataca cada vez que Whim hace acto de presencia."
silverroachy = "SilverRoachy hace acto de presencia. Dale una descarga en las cámaras; permanecer inactivo un rato desactivará tus cámaras."
silverroachy1 = "SilverRoachy avanza ahora con mayor velocidad."
silverroachy2 = "SilverRoachy es ahora letal."
beanie = "Beanie hace acto de presencia. Aparecerá de forma aleatoria en la oficina, ¡acierta en ella!"
beanieboss = "EN TODO SU ESPLENDOR"
randommodifier = "Activa un modificador aleatorio y otorga el doble de bonificación de puntos a cambio."

