[modifiersdescriptions]
whim = "A Whim aparece. Ela se move em direção ao seu escritório a partir da câmera 1; faça um parry nela quando ela aparecer."
whim1 = "O tempo concedido para o parry da Whim diminui."
whim2 = "Após dar um parry na Whim, você deve ir para a câmera 1 e dar um choque nela."
n = "A N aparece. Ela entra no escritório a partir da câmera 1; jogue uma pedra nela."
n1 = "Agora a N exige uma pedra extra jogada para espantá-la."
twoany = "A 2any aparece. Move-se da câmera 2; feche a porta quando ouvir ela falar."
twoany1 = "A 2any não vai embora imediatamente; em vez disso, exige manter a porta fechada por meio segundo."
twoany2 = "Agora aparecem duas 2any."
wanton = "A Wanton aparece. Move-se em direção ao seu escritório; passe o mouse verticalmente segurando o cursor sobre ela para fazê-la ir embora."
wanton1 = "A Wanton exige mais movimentos de mouse para ir embora, e o cronômetro de morte dela é mais longo."
wanton2 = "Agora a Wanton pode aparecer de qualquer lado do escritório."
pompous = "A Pompous aparece. Move-se da câmera 1 para o seu escritório; fique imóvel com o cursor sobre ela até que ela vá embora."
pompous1 = "A Pompous agora pode atacar de qualquer lado e desaparece após aparecer."
creep = "A creep aparece. Movimenta-se pela câmera 7; dê um choque nela para recuar uma fase."
creep1 = "A creep se move mais rápido quanto mais tempo você passa sem verificá-la."
rancor = "A RANCOR aparece. Move-se da câmera 6 ou 7 antes de aparecer na lateral do escritório; faça um parry nela."
rancor1 = "A RANCOR ataca 4 vezes seguidas, mudando de lado a cada vez."
rancor2 = "Aparecem 2 RANCORs, e elas atacam simultaneamente."
stitchwork = "A Stitchwork aparece. Ela aparecerá ao lado de sua própria alucinação; dê um choque nela na câmera marcada em marrom."
stitchwork1 = "A alucinação da Stitchwork desaparece ao iniciar o ataque dela."
stitchwork2 = "A Stitchwork exige 2 choques e se move após receber um."
conceit = "A Conceit aparece. Ao aparecer, fique imóvel rapidamente no escritório assim que ela abrir a boca."
conceit1 = "A Conceit não pode receber parry; isso apenas reinicia o ataque dela."
conceit2 = "Você deve ficar imóvel ANTES que a Conceit abra a boca."
qualm = "A Qualm aparece. Periodicamente aparece no escritório; dê um parry nela 3 vezes para fazê-la ir embora, movendo-se a cada vez."
qualm1 = "A Qualm agora se move constantemente."
qualm2 = "A Qualm drena passivamente a VELOCIDADE durante o ataque, fazendo isso com mais força conforme o ataque avança."
reap = "O Reap aparece. Ele seguirá o cursor do mouse, te matando se for deixado imóvel por muito tempo."
reap1 = "O Reap agora pula em direção ao seu cursor em surtos em vez de caminhar suavemente."
reap2 = "Dar um parry no Reap agora provoca um ataque da Whim, N, RANCOR ou Caustic."
caustic = "A Caustic aparece. Um sinal de aviso aparecerá no escritório; jogue uma pedra nela ao aparecer."
caustic1 = "A Caustic agora se move após cada flash de aviso."
caustic2 = "A Caustic mostra o aviso apenas duas vezes."
travis = "O Travis aparece. De vez em quando ele espreitará pela porta, feche-a e depois vá para a câmera 6 ou 7 para dar um choque nele."
travis1 = "O Travis agora ataca com mais frequência."
travis2 = "O Travis provoca um ataque da N após realizar seu golpe rápido."
blackened = "O Blackened aparece. Move-se pelo corredor do seu escritório. Clicar nele fará com que ele recue."
blackened1 = "Se o Blackened atingir 50% de progresso, você só poderá empurrá-lo de volta até esse ponto."
blackened2 = "Seus cliques empurram o Blackened a uma distância menor."
dozer = "O Dozer aparece. Mantenha o cursor imóvel no terço inferior da tela."
dozer1 = "O Dozer acorda mais rápido."
dozer2 = "O Dozer agora ataca toda vez que a Whim aparece."
silverroachy = "O SilverRoachy aparece. Dê um choque nele nas câmeras; ficar ocioso por um tempo desativará suas câmeras."
silverroachy1 = "O SilverRoachy agora avança mais rápido."
silverroachy2 = "O SilverRoachy agora é mortal."
beanie = "A Beanie aparece. Ela aparecerá aleatoriamente no escritório, acerte-a!"
beanieboss = "EM TODA A SUA GLÓRIA"
randommodifier = "Ativa um modificador aleatório e dá o dobro de bônus de pontos em troca."

